{
  "info": {
    "_postman_id": "6f1c2a7e-0000-4000-8000-zerotrust0002",
    "name": "Zero Trust – Uji Jam Akses",
    "description": "Jalankan gateway dengan JAM_MULAI/JAM_SELESAI yang TIDAK mencakup jam saat ini, lalu jalankan koleksi ini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Jam akses (4.3)",
      "item": [
        {
          "name": "Login dosen1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceDosen1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dosen1\",\n  \"password\": \"dosen123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"tokenDosen1\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Perubahan nilai di luar jam akses -> 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDosen1}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceDosen1}}"
              }
            ],
            "url": "{{baseUrl}}/nilai/N-001",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nilai_angka\": 80\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Alasan menyebut jam akses\", function () {",
                  "  pm.expect(pm.response.json().alasan).to.include(\"jam akses\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Finalisasi di luar jam akses -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDosen1}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceDosen1}}"
              }
            ],
            "url": "{{baseUrl}}/kelas/KLS-1/finalisasi"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Alasan menyebut jam akses\", function () {",
                  "  pm.expect(pm.response.json().alasan).to.include(\"jam akses\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Baca nilai di luar jam akses tetap -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDosen1}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceDosen1}}"
              }
            ],
            "url": "{{baseUrl}}/nilai"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}